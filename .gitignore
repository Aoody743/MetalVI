# ---------------------------------------------------------------------------
# RULE #1: nothing from the game (or any other proprietary source) is ever
# committed.
# Everything is built from files the user supplies at runtime.
# This file is the first line of defence; `cargo xtask policy` (also run by
# the pre-commit hook in .githooks/) is the second and is authoritative.
# See docs/asset-policy.md.
# ---------------------------------------------------------------------------

# Build output
/target/
/tests/fixtures/*/target/

# Local configuration (contains paths to YOUR files)
/victory.toml

# Places people tend to drop data into. Keep data outside the repo instead.
/game/
/games/
/assets/
/data/
/dump/
/dumps/
/extracted/
/cache/
/out/

# Executables, libraries, symbols
*.exe
*.dll
*.pdb
*.lib
*.sys
*.obj
*.exp
*.ilk

# Console packages and containers
*.xvd
*.xvc
*.msixvc
*.xsp
*.cab
*.msi

# Typical game data (non-exhaustive on purpose; the policy check is an allowlist)
*.bin
# The one exception (docs/asset-policy.md): the BCPack format's constant tables.
!/crates/victory-formats/src/bcpack-tables.bin
*.dat
*.pak
*.rpf
*.dds
*.ktx
*.ktx2
*.dxbc
*.dxil
*.cso
*.spv
*.wav
*.xma
*.ogg
*.opus
*.mp3
*.mp4
*.bik
*.bk2
*.awc
*.zip
*.7z
*.rar

# Editor / OS noise
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store

# victorymetal build output: holds a copy of Apple's Metal Shader Converter
# library (libmetalirconverter, renamed), which is Apple's and must not be
# redistributed. Each user builds it from their own MSC install.
/native/victorymetal/build/
/scripts/macos/*.dylib

# ---------------------------------------------------------------------------
# F70 (repo hygiene): artifacts produced by our own tooling. These keep
# warm-up output, suite temp dirs, capture folders, patch fallbacks, private
# Wine prefixes and generic build dirs out of `git status`. The allowlist in
# xtask/src/policy.rs remains the authoritative check.
# ---------------------------------------------------------------------------

# F46 (victory-warm-metal): MSC converted shaders in VICTORY_METAL_CACHE
# (`<hash32>.vmsc`; `<hash32>.tmp<pid>.<thread>` atomic-write siblings), and a
# metal-cache directory if the cache is ever pointed inside the repository.
*.vmsc
*.tmp[0-9]*
/metal-cache/

# F58 (scripts/macos/metal-suite.sh): mktemp directories `metal-suite.XXXXXXXX`
# (private Wine prefix, copied Wine tree, logs) if the suite temp/log dir is
# created inside the repository.
metal-suite.*/

# Frame capture (VICTORY_CAPTURE folder): frame-<n>.png, frame-<n>-ops.txt.
/capture/
/captures/

# Patch fallbacks: original copies and rejected hunks from apply/patch.
*.orig
*.rej

# Private Wine prefixes mistakenly created inside the repository.
/prefix/
/wineprefix/
/prefixes/

# Generic build output directory (Cargo's own /target/ is already ignored).
/build/
